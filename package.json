{
  "name": "assistant-aptitude-medicale",
  "version": "1.0.0",
  "description": "Assistant Virtuel d'Aptitude Médicale",
  "author": "Pr. Nezzal Abdelmalek <pedagogiafrica@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.pedagogiafrica.assistant-aptitude-medicale",
    "productName": "Assistant Aptitude Medicale",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "backend/dist/app",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "frontend",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "documents",
        "to": "documents",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "icon": "frontend/logo.png",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "frontend/logo.png",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "frontend/logo.png",
      "target": ["AppImage", "deb"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
